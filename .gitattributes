# Normalize line endings: LF in the repository and in every checkout, so a
# published package and a contributor's diff never carry CRLF from a Windows
# working copy.
* text=auto eol=lf

# The graphify knowledge graph is committed so every clone gets cheap context.
# It is machine-generated and regenerated on both sides of a branch, so a plain
# textual merge always conflicts. Union-merge it instead via graphify's driver.
# The driver is registered in local git config by `graphify hook install`;
# without it git falls back to the normal merge and this line is inert.
graphify-out/graph.json merge=graphify

# Keep generated graph artifacts out of diffs and language stats.
graphify-out/** linguist-generated=true

# Test fixtures are byte-exact by definition: pin them binary so the repo-wide
# text=auto heuristic can never rewrite a zip or a payload on checkout.
*.zip binary
*.bin binary
*.epub binary
